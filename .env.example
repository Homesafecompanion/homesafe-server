# PostgreSQL connection string. On Render, set automatically when the
# Postgres add-on is linked to the web service.
DATABASE_URL=postgres://user:password@host:5432/homesafe

# Anthropic API key (used by /translate and /interpret).
ANTHROPIC_API_KEY=

# OpenAI API key (used by /transcribe and /speak).
OPENAI_API_KEY=

# Optional. Defaults to 3000.
PORT=3000
